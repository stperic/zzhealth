{
	"name": "zzhealth",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "26.7.0"
	},
	"scripts": {
		"dev": "next dev --hostname 127.0.0.1",
		"build": "next build",
		"start": "next start --hostname 127.0.0.1",
		"lint": "biome check .",
		"check": "next typegen && tsc --noEmit",
		"test": "vitest run",
		"test:evidence": "vitest run --reporter=default --reporter=junit --outputFile.junit=.zztrace/unit.xml",
		"test:e2e": "playwright test",
		"verify": "npm run check && npm run lint && npm test && npm run build && npm run test:e2e",
		"trace:check": "zztrace-trace check",
		"trace:mcp": "zztrace-trace --repo ."
	},
	"dependencies": {
		"next": "16.4.2",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "1.64.1",
		"@types/node": "26.6.5",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"typescript": "^5",
		"vitest": "5.0.5"
	}
}
